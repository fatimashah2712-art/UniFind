<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="72dp"
        android:text="@string/forgot_title"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvForgotSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvForgotTitle"
        android:layout_marginTop="8dp"
        android:text="@string/forgot_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvForgotSubtitle"
        android:layout_marginTop="40dp"
        android:hint="@string/hint_email">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etForgotEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSendLink"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/tilForgotEmail"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary"
        android:text="@string/btn_send_link"
        android:textColor="@color/on_primary" />

    <TextView
        android:id="@+id/tvBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnSendLink"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:padding="4dp"
        android:text="@string/back_to_login"
        android:textColor="@color/primary"
        android:textStyle="bold" />

</RelativeLayout>